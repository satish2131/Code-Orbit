{
  "expo": {
    "name": "CodeOrbit",
    "slug": "codeorbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/APP-LOGO.png",
    "userInterfaceStyle": "automatic",
    "scheme": "codeorbit",
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/APP-LOGO.png",
      "resizeMode": "contain",
      "backgroundColor": "#17181A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codeorbit.app",
      "jsEngine": "hermes"
    },
    "android": {
      "package": "com.codeorbit.app",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "backgroundColor": "#17181A",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "androidNavigationBar": {
      "backgroundColor": "#17181A",
      "barStyle": "light-content"
    },
    "web": {
      "favicon": "./assets/APP-LOGO.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan session QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to select profile pictures."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc9dbeff-cc9b-45e6-86fa-93a690ca8cc6"
      }
    }
  }
}
